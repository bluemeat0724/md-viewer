{
  "name": "@bluemeat0724/md-viewer",
  "version": "0.6.0",
  "description": "Scan a directory of Markdown files and build a self-contained, offline md-viewer.html",
  "type": "module",
  "bin": {
    "md-viewer": "bin/md-viewer.mjs"
  },
  "main": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "markdown",
    "viewer",
    "cli",
    "mermaid",
    "offline"
  ],
  "license": "MIT",
  "dependencies": {
    "marked": "^18.0.10",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.16.1",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "test": "node --test"
  }
}
